        "    /// Sends exactly once; for callers that must not retry.",
        "    pub async fn send_once(&self, req: Request) -> Result<Response, RpcError> {",
        "        let http = self.build_request(&req)?;",
        "        let timeout = self.config.timeout;",
        "        let resp = self.transport.execute(http, timeout).await?;",
        "        if resp.status().is_server_error() {",
        "            tracing::debug!(status = %resp.status(), method = %req.method, \"send_once: server error\");",
        "        }",
        "        Ok(resp)",
        "    }",
