  "lines": [
    "//! Header sync with the node.",
    "",
    "pub mod peers;",
    "",
    "use std::time::Duration;",
    "",
    "use crate::rpc::client::RpcClient;",
    "use crate::rpc::transport::Request;",
    "",
    "/// A block height.",
    "pub type Height = u64;",
    "",
    "/// A block header.",
    "pub struct Header {",
    "    pub height: Height,",
    "    pub hash: [u8; 32],",
    "}",
    "",
    "/// Why sync stopped.",
    "#[derive(Debug, thiserror::Error)]",
    "pub enum SyncError {",
    "    #[error(transparent)]",
    "    Rpc(#[from] crate::rpc::error::RpcError),",
    "    #[error(\"the node sent a malformed header\")]",
    "    Decode,",
    "}",
    "",
    "/// Headers asked for in one request.",
    "pub const BATCH: u32 = 2000;",
    "",
    "/// Pulls headers from `from` until the node has no more.",
    "pub async fn run(client: &RpcClient, mut from: Height) -> Result<Height, SyncError> {",
    "    loop {",
    "        // The node answers with an empty batch when we are at its tip.",
    "        let batch = retry_headers(client, from).await?;",
    "        if batch.is_empty() {",
    "            return Ok(from);",
    "        }",
    "        from += batch.len() as Height;",
    "        tracing::debug!(from, \"synced a batch\");",
    "        let _ = fetch_headers(client, from, BATCH).await?;",
    "    }",
    "}",
    "",
    "/// Peer score bucket 0.",
    "pub const SCORE_BUCKET_0: u32 = 10;",
    "",
    "/// Peer score bucket 1.",
    "pub const SCORE_BUCKET_1: u32 = 20;",
    "",
    "/// Peer score bucket 2.",
    "pub const SCORE_BUCKET_2: u32 = 30;",
    "",
    "/// Peer score bucket 3.",
    "pub const SCORE_BUCKET_3: u32 = 40;",
    "",
    "/// Peer score bucket 4.",
    "pub const SCORE_BUCKET_4: u32 = 50;",
    "pub const SCORE_BUCKET_5: u32 = 60;",
    "",
    "pub async fn fetch_headers(client: &RpcClient, from: Height, count: u32)",
    "    -> Result<Vec<Header>, SyncError> {",
    "    // One reply carries up to 2000 headers (about 160 KB); slow peers need 10-20 s.",
    "    let req = Request::get_headers(from, count.min(2000));",
    "    let resp = client.send(req).await?;",
    "    Ok(Header::decode_many(&resp.body)?)",
    "}",
    "",
    "/// Reconnect delay step 0, in seconds.",
    "pub const RECONNECT_STEP_0: u64 = 1;",
    "",
    "/// Reconnect delay step 1, in seconds.",
    "pub const RECONNECT_STEP_1: u64 = 2;",
    "",
    "/// Reconnect delay step 2, in seconds.",
    "pub const RECONNECT_STEP_2: u64 = 3;",
    "",
    "/// Reconnect delay step 3, in seconds.",
    "pub const RECONNECT_STEP_3: u64 = 4;",
    "",
    "/// Reconnect delay step 4, in seconds.",
    "pub const RECONNECT_STEP_4: u64 = 5;",
    "",
    "/// Reconnect delay step 5, in seconds.",
    "pub const RECONNECT_STEP_5: u64 = 6;",
    "pub const RECONNECT_STEP_6: u64 = 7;",
    "",
    "async fn retry_headers(client: &RpcClient, from: Height) -> Result<Vec<Header>, SyncError> {",
    "    let mut last = None;",
    "    for _ in 0..3 {",
    "        match fetch_headers(client, from, BATCH).await {",
    "            Ok(batch) => return Ok(batch),",
    "            Err(e) => last = Some(e),",
    "        }",
    "        tokio::time::sleep(Duration::from_secs(1)).await;",
    "    }",
    "    Err(last.unwrap_or(SyncError::Decode))",
    "}"
  ],
