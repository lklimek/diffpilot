# diffpilot deployment configuration (plan §5.2, ADR-013). Copy to `.env` (mode 0600, never committed) and
# pass it to compose:  docker compose --env-file .env -f deploy/compose.yaml up -d
# Placeholders only. Values marked "secret" are generated by docs/runbook.md, "First deploy".
# Compose passes these to the containers; variables the containers fix themselves (data paths, listen ports,
# the runner's state layout) are set in deploy/compose.yaml and the images and are not repeated here.

# --- Server: public URL and reverse proxy ---------------------------------------------------------------------
# Public base URL; the GitHub App callback is <SR_PUBLIC_URL>/auth/github/callback. https:// makes cookies Secure.
SR_PUBLIC_URL=https://review.example.com
# GitHub logins allowed to sign in, comma-separated, case-insensitive (e.g. octocat,hubot). Applied at every server
# start: missing logins are added, the others removed together with their sessions and access tokens.
SR_ALLOWED_LOGINS=REPLACE_WITH_GITHUB_LOGINS
# Address and port the server's HTTP listener is published on (for the reverse proxy on this host: loopback).
SR_PUBLISH_ADDR=127.0.0.1
SR_HTTP_PORT=3000
# Comma-separated addresses or CIDRs of reverse proxies whose X-Forwarded-For is trusted (empty: none). Requests
# from the host reach the container from the public network's gateway (default 172.29.73.1).
SR_TRUSTED_PROXIES=172.29.73.1
# secret: 32 random bytes, base64 (`openssl rand -base64 32`); encrypts tokens at rest; no rotation in v1.
SR_SECRET_KEY=REPLACE_WITH_BASE64_32_BYTES
# secret: shared by the server and the runner (`openssl rand -hex 32`); see runbook "Rotating the runner secret".
SR_RUNNER_SECRET=REPLACE_WITH_RANDOM_HEX

# --- GitHub App -----------------------------------------------------------------------------------------------
SR_GITHUB_APP_ID=123456
SR_GITHUB_CLIENT_ID=Iv23liREPLACE
# secret
SR_GITHUB_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# Host path of the App's private key (.pem, mode 0400, readable by uid 10010); mounted read-only, never copied.
SR_GITHUB_APP_PRIVATE_KEY_PATH=/srv/diffpilot/secrets/github-app.pem
# Base URLs (defaults: github.com); only change for a GitHub Enterprise Server or a test double.
SR_GITHUB_API_URL=https://api.github.com
SR_GITHUB_OAUTH_URL=https://github.com
SR_GITHUB_CLONE_URL=https://github.com

# --- MemCan (pure configuration; the egress proxy allows exactly this host:port in private ranges) --------------
# The full MCP endpoint (nothing appends /mcp). Its host must be in MemCan's MEMCAN_ALLOWED_HOSTS and resolve at
# the proxy's start (the proxy pins that address); the server and the proxy both connect to it (docs/runbook.md,
# "First deploy", MemCan).
SR_MEMCAN_URL=http://memcan.example.lan:8190/mcp
# secret
SR_MEMCAN_TOKEN=REPLACE_WITH_MEMCAN_TOKEN
# Optional: MemCan web UI base including /ui (e.g. http://memcan.example.lan:8190/ui); the dashboard links TODOs to
# <base>/tasks/<uuid>. Empty: no links.
SR_MEMCAN_UI_URL=

# --- Secrets as files (optional, ADR-001) ----------------------------------------------------------------------
# With deploy/compose.secrets.yaml the four secrets above come from read-only files in this directory instead
# (leave the four variables empty); files, owners and modes: docs/runbook.md, "Secrets as files".
# SR_SECRETS_DIR=/srv/diffpilot/secrets

# --- Runner ----------------------------------------------------------------------------------------------------
SR_RUNNER_ID=runner
# Where the agent's skills come from: claudius repository, ref (branch, tag or commit SHA; a commit SHA pins the
# skills and is recommended for production), refresh interval in seconds, and the skills a job may get.
SR_RUNNER_CLAUDIUS_URL=https://github.com/lklimek/claudius.git
SR_RUNNER_CLAUDIUS_REF=main
SR_RUNNER_CLAUDIUS_REFRESH_SECS=21600
SR_RUNNER_SKILLS=severity
# Days an agent session is kept after its last job.
SR_RUNNER_SESSION_RETENTION_DAYS=14
# MiB that must stay free on the disk holding Docker's volumes; below it the runner takes no job (jobs stay queued),
# warns hourly and is unhealthy (docs/runbook.md, "Temporary volumes"). A start condition, not a per-job limit.
SR_RUNNER_DISK_RESERVE_MIB=2048
# Supervisor: deadline of the job-end sweep in ms; a sweep that misses it ends the container (exit 70).
SR_SUPERVISOR_SWEEP_DEADLINE_MS=5000
# Resource limits of the runner container (agents included).
SR_RUNNER_MEM_LIMIT=6g
SR_RUNNER_PIDS_LIMIT=1024
SR_RUNNER_CPUS=2
SR_SERVER_MEM_LIMIT=2g
SR_SERVER_CPUS=2

# --- Networks (pinned; change only on an address clash, and update MemCan's allowlist with the egress address) -
SR_PUBLIC_SUBNET=172.29.73.0/24
SR_SERVER_PUBLIC_ADDR=172.29.73.2
SR_RUNNER_SUBNET=172.29.71.0/24
SR_SERVER_RUNNER_ADDR=172.29.71.2
SR_PROXY_RUNNER_ADDR=172.29.71.3
SR_RUNNER_ADDR=172.29.71.4
SR_EGRESS_SUBNET=172.29.72.0/24
SR_PROXY_EGRESS_ADDR=172.29.72.2

# --- Images (built locally by default; set to a registry tag to pull instead) ----------------------------------
# Published: docker.io/lklimek/diffpilot, -runner and -egress-proxy, all three at one X.Y.Z (docs/deployment.md).
SR_SERVER_IMAGE=diffpilot-server:local
SR_RUNNER_IMAGE=diffpilot-runner:local
SR_PROXY_IMAGE=diffpilot-egress-proxy:local

# --- Logging ---------------------------------------------------------------------------------------------------
RUST_LOG=info
