{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LauncherResponse",
  "description": "Correlated response; attach upgrades the connection to a raw relay after acknowledgement.",
  "type": "object",
  "properties": {
    "id": {
      "description": "Original request id.",
      "type": "string"
    },
    "workers": {
      "description": "Managed workers (list), otherwise empty.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkerStatus"
      }
    }
  },
  "required": [
    "id",
    "workers"
  ],
  "$defs": {
    "WorkerStatus": {
      "description": "Managed worker identity and current lifecycle state.",
      "type": "object",
      "properties": {
        "container": {
          "description": "Worker identity derived from managed labels.",
          "$ref": "#/$defs/ContainerId"
        },
        "running": {
          "description": "Whether it is currently running.",
          "type": "boolean"
        }
      },
      "required": [
        "container",
        "running"
      ]
    },
    "ContainerId": {
      "description": "A worker's identity; each identity owns at most one running job.",
      "oneOf": [
        {
          "description": "Persistent PR worker (CS1).",
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "pr"
            },
            "pull_request_id": {
              "description": "Database PR key.",
              "type": "integer",
              "format": "int64"
            },
            "payer": {
              "description": "User paying for this worker's turns.",
              "$ref": "#/$defs/UserId"
            }
          },
          "required": [
            "shape",
            "pull_request_id",
            "payer"
          ]
        },
        {
          "description": "Ephemeral answer-only worker (CS2).",
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "judge"
            },
            "payer": {
              "description": "Dashboard user paying for the turn.",
              "$ref": "#/$defs/UserId"
            }
          },
          "required": [
            "shape",
            "payer"
          ]
        }
      ]
    },
    "UserId": {
      "description": "Stable authenticated user id, also the payer key.",
      "type": "string"
    }
  }
}
