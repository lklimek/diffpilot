{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialStatus",
  "description": "Non-secret status shared by gateway, server and Settings.",
  "type": "object",
  "properties": {
    "telemetry": {
      "description": "Safe observations, without tokens, key IDs or upstream response bodies.",
      "$ref": "#/$defs/CredentialTelemetry",
      "default": {
        "linked_at": null,
        "primary": null,
        "secondary": null,
        "tokens_today": null,
        "tokens_month": null,
        "live_containers": null
      }
    },
    "challenge": {
      "description": "Current device challenge on the staged-link GET only; reading never starts a flow.",
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceLink"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mode": {
      "description": "Only ChatGPT-plan linking is supported.",
      "$ref": "#/$defs/CredentialMode"
    },
    "state": {
      "description": "Common connection state.",
      "$ref": "#/$defs/CredentialState"
    },
    "relink_reason": {
      "description": "Present only when relink is needed.",
      "anyOf": [
        {
          "$ref": "#/$defs/RelinkReason"
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "description": "Human-readable connection label.",
      "type": [
        "string",
        "null"
      ]
    },
    "plan": {
      "description": "Provider plan label, when supplied.",
      "type": [
        "string",
        "null"
      ]
    },
    "paused_until": {
      "description": "Payer pause after a usage limit.",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_call": {
      "description": "Most recent model call.",
      "anyOf": [
        {
          "$ref": "#/$defs/LlmCallOutcome"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "mode",
    "state"
  ],
  "$defs": {
    "CredentialTelemetry": {
      "description": "Safe account observations; gateway fills plan data and server fills payer job data.",
      "type": "object",
      "properties": {
        "linked_at": {
          "description": "Gateway commit time of the current account link; refresh does not change it.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "primary": {
          "description": "Last observed primary plan window.",
          "anyOf": [
            {
              "$ref": "#/$defs/PlanUsage"
            },
            {
              "type": "null"
            }
          ]
        },
        "secondary": {
          "description": "Last observed secondary plan window.",
          "anyOf": [
            {
              "$ref": "#/$defs/PlanUsage"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens_today": {
          "description": "Retained provider reports finished today in UTC, null without reports.",
          "anyOf": [
            {
              "$ref": "#/$defs/UsageTotals"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens_month": {
          "description": "Retained provider reports finished this calendar month in UTC, null without reports.",
          "anyOf": [
            {
              "$ref": "#/$defs/UsageTotals"
            },
            {
              "type": "null"
            }
          ]
        },
        "live_containers": {
          "description": "Server-known containers with claimed/running jobs; null until read from server state.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ContainerId"
          }
        }
      }
    },
    "PlanUsage": {
      "description": "Observed usage of one plan window; absent fields have not been reported upstream.",
      "type": "object",
      "properties": {
        "used_percent": {
          "description": "Percentage supplied by x-codex-*-used-percent; never estimated from tokens.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "resets_at": {
          "description": "Absolute reset time supplied by the backend.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "UsageTotals": {
      "description": "Token sums; cached input is included in input, not additional to it.",
      "type": "object",
      "properties": {
        "input_tokens": {
          "description": "Input tokens, including cached input.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cached_input_tokens": {
          "description": "Cached input tokens.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "description": "Output tokens.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reasoning_output_tokens": {
          "description": "Unknown: the retained job-result contract does not store reasoning tokens separately.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "jobs": {
          "description": "Finished jobs with a provider usage report, including Ask and all analysis rounds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "jobs"
      ]
    },
    "ContainerId": {
      "description": "A worker's identity; each identity owns at most one running job.",
      "oneOf": [
        {
          "description": "Persistent PR worker (CS1).",
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "pr"
            },
            "pull_request_id": {
              "description": "Database PR key.",
              "type": "integer",
              "format": "int64"
            },
            "payer": {
              "description": "User paying for this worker's turns.",
              "$ref": "#/$defs/UserId"
            }
          },
          "required": [
            "shape",
            "pull_request_id",
            "payer"
          ]
        },
        {
          "description": "Ephemeral answer-only worker (CS2).",
          "type": "object",
          "properties": {
            "shape": {
              "type": "string",
              "const": "judge"
            },
            "payer": {
              "description": "Dashboard user paying for the turn.",
              "$ref": "#/$defs/UserId"
            }
          },
          "required": [
            "shape",
            "payer"
          ]
        }
      ]
    },
    "UserId": {
      "description": "Stable authenticated user id, also the payer key.",
      "type": "string"
    },
    "DeviceLink": {
      "description": "Public device-code challenge; upstream tokens never cross this boundary.",
      "type": "object",
      "properties": {
        "user_code": {
          "description": "Short code the owner enters at the provider.",
          "type": "string"
        },
        "verification_url": {
          "description": "Fixed provider verification page.",
          "type": "string"
        },
        "expires_at": {
          "description": "Deadline of the staged attempt.",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "user_code",
        "verification_url",
        "expires_at"
      ]
    },
    "CredentialMode": {
      "description": "The only supported credential mode; no paid fallback.",
      "oneOf": [
        {
          "description": "Gateway-run ChatGPT-plan device linking.",
          "type": "string",
          "const": "chatgpt_plan"
        }
      ]
    },
    "CredentialState": {
      "description": "ChatGPT-plan connection state.",
      "oneOf": [
        {
          "description": "A staged connection attempt, preserving an existing usable connection.",
          "type": "string",
          "const": "linking"
        },
        {
          "description": "A usable credential is held by the gateway.",
          "type": "string",
          "const": "linked"
        },
        {
          "description": "Explicit user action is required; the gateway responds with HTTP 403.",
          "type": "string",
          "const": "relink_needed"
        }
      ]
    },
    "RelinkReason": {
      "description": "Safe relink reason; never contains a token, upstream response or account identifier.",
      "oneOf": [
        {
          "description": "The upstream definitively rejected the credential.",
          "type": "string",
          "const": "terminal"
        },
        {
          "description": "Exchange or persistence outcome is unknown; the generation must never be replayed.",
          "type": "string",
          "const": "quarantined"
        }
      ]
    },
    "LlmCallOutcome": {
      "description": "Outcome and time of an LLM call.",
      "type": "object",
      "properties": {
        "at": {
          "description": "When the call ended.",
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "description": "Whether it worked.",
          "$ref": "#/$defs/LlmCallStatus"
        }
      },
      "required": [
        "at",
        "status"
      ]
    },
    "LlmCallStatus": {
      "description": "Whether the LLM worked on its most recent call (brief §4.4).",
      "oneOf": [
        {
          "description": "The call succeeded.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "working"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "description": "The call failed.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "not_working"
            },
            "message": {
              "description": "Plain error message.",
              "type": "string"
            }
          },
          "required": [
            "state",
            "message"
          ]
        }
      ]
    }
  }
}
