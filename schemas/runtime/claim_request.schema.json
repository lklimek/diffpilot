{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimRequest",
  "description": "Body of `POST /runner/v1/claim`.",
  "type": "object",
  "properties": {
    "runner_id": {
      "description": "Stable name of the runner instance, for logs.",
      "type": "string"
    },
    "retired": {
      "description": "PR containers and local keys successfully retired after the preceding claim.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "int64"
      }
    }
  },
  "required": [
    "runner_id"
  ]
}
