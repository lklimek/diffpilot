{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LinkCredential",
  "description": "Starts device linking without accepting upstream secrets or endpoints.",
  "type": "object",
  "properties": {
    "mode": {
      "description": "ChatGPT-plan linking only.",
      "$ref": "#/$defs/CredentialMode"
    }
  },
  "additionalProperties": false,
  "required": [
    "mode"
  ],
  "$defs": {
    "CredentialMode": {
      "description": "The only supported credential mode; no paid fallback.",
      "oneOf": [
        {
          "description": "Gateway-run ChatGPT-plan device linking.",
          "type": "string",
          "const": "chatgpt_plan"
        }
      ]
    }
  }
}
