{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DashboardSummary",
  "description": "Response of `GET /api/v1/dashboard`: the user's dashboard without its items.",
  "type": "object",
  "properties": {
    "revision": {
      "description": "Opaque; changes whenever the stored snapshot or its ranking changes (poll this, then fetch the items).",
      "type": "string"
    },
    "latest_refresh": {
      "description": "The newest refresh of the user, live or ended; null before the first.",
      "anyOf": [
        {
          "$ref": "#/$defs/RefreshStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot": {
      "description": "The snapshot the items come from; null before the first successful scan.",
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotMeta"
        },
        {
          "type": "null"
        }
      ]
    },
    "schedule": {
      "description": "The daily automatic refresh.",
      "$ref": "#/$defs/ScheduleStatus"
    },
    "older_prompt_judgements": {
      "description": "Items of the snapshot whose judgement came from an older ranking prompt (re-judged within the caps).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "revision",
    "schedule",
    "older_prompt_judgements"
  ],
  "$defs": {
    "RefreshStatus": {
      "description": "One refresh: scan progress, ranking and outcome (`GET /api/v1/dashboard/refreshes/{id}`, SSE `refresh`).",
      "type": "object",
      "properties": {
        "id": {
          "description": "Id.",
          "$ref": "#/$defs/RefreshId"
        },
        "trigger": {
          "description": "What started it.",
          "$ref": "#/$defs/RefreshTrigger"
        },
        "state": {
          "description": "State.",
          "$ref": "#/$defs/RefreshState"
        },
        "judged": {
          "description": "Items the LLM judged in this refresh.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reused": {
          "description": "Items whose stored judgement was reused at no cost (judged inputs unchanged).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "left_provisional": {
          "description": "Items left provisional by the per-refresh or daily ranking limit.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "steps": {
          "description": "Scan steps in order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScanStep"
          }
        },
        "percent": {
          "description": "Scan progress, 0–100.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "started_at": {
          "description": "Start time.",
          "type": "string",
          "format": "date-time"
        },
        "scanned_at": {
          "description": "When the scan finished and the snapshot was stored; null while scanning or when it failed.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ranking": {
          "description": "The LLM ranking of the snapshot; null before the scan finished.",
          "anyOf": [
            {
              "$ref": "#/$defs/RankingStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "description": "Why the scan failed; null unless `failed`.",
          "anyOf": [
            {
              "$ref": "#/$defs/RefreshFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "log": {
          "description": "Plain log lines of the scan (at most 200, oldest first); no tokens, no query strings.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "trigger",
        "state",
        "judged",
        "reused",
        "left_provisional",
        "steps",
        "percent",
        "started_at",
        "log"
      ]
    },
    "RefreshId": {
      "description": "Identifier of a dashboard refresh (one scan and its ranking).",
      "type": "string",
      "format": "uuid"
    },
    "RefreshTrigger": {
      "description": "What started a refresh.",
      "oneOf": [
        {
          "description": "The user's Refresh action.",
          "type": "string",
          "const": "manual"
        },
        {
          "description": "The daily schedule.",
          "type": "string",
          "const": "scheduled"
        }
      ]
    },
    "RefreshState": {
      "description": "State of a refresh; transitions in `docs/contracts/http-api.md` \"Refresh states\". At most one refresh per user\nis `scanning` or `ranking`; only `ranking` and `finished` refreshes hold a snapshot.",
      "oneOf": [
        {
          "description": "Reading GitHub and MemCan; no snapshot yet.",
          "type": "string",
          "const": "scanning"
        },
        {
          "description": "The snapshot is stored and current; the LLM judges new and changed items.",
          "type": "string",
          "const": "ranking"
        },
        {
          "description": "The snapshot is current; the ranking ended with the outcome in `ranking.state`.",
          "type": "string",
          "const": "finished"
        },
        {
          "description": "The scan failed before its snapshot was complete; the previous snapshot stays.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "The scan was cancelled before its snapshot was complete; the previous snapshot stays.",
          "type": "string",
          "const": "cancelled"
        }
      ]
    },
    "ScanStep": {
      "description": "A step of the scan, shown as a list with progress.",
      "type": "object",
      "properties": {
        "key": {
          "description": "Which step.",
          "$ref": "#/$defs/ScanStepKey"
        },
        "state": {
          "description": "Its state.",
          "$ref": "#/$defs/StepState"
        },
        "done": {
          "description": "Units done (e.g. PR details read); null when the step has no count.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "total": {
          "description": "Units in total; null when not known yet or not counted.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "detail": {
          "description": "Plain detail, e.g. the item being read or why the step failed.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "state"
      ]
    },
    "ScanStepKey": {
      "description": "The scan steps, in order (plan §A.4).",
      "oneOf": [
        {
          "description": "Pull request searches (authored, assigned, review requested).",
          "type": "string",
          "const": "search_prs"
        },
        {
          "description": "Issue searches (watched repositories, assigned, mentions).",
          "type": "string",
          "const": "issues"
        },
        {
          "description": "Pull request details (CI, reviews, threads, timeline).",
          "type": "string",
          "const": "pr_details"
        },
        {
          "description": "Ownership policies, releases, milestones, reach.",
          "type": "string",
          "const": "context"
        },
        {
          "description": "Pull request and review history for the charts.",
          "type": "string",
          "const": "history"
        },
        {
          "description": "MemCan TODOs.",
          "type": "string",
          "const": "todos"
        },
        {
          "description": "LLM ranking of new and changed items.",
          "type": "string",
          "const": "ranking"
        }
      ]
    },
    "StepState": {
      "description": "State of a scan step.",
      "oneOf": [
        {
          "description": "Not started.",
          "type": "string",
          "const": "waiting"
        },
        {
          "description": "In progress.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Done.",
          "type": "string",
          "const": "done"
        },
        {
          "description": "Failed; `detail` says why.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Not run (e.g. TODOs switched off).",
          "type": "string",
          "const": "skipped"
        }
      ]
    },
    "RankingStatus": {
      "description": "The LLM ranking of a stored snapshot.",
      "type": "object",
      "properties": {
        "state": {
          "description": "State.",
          "$ref": "#/$defs/RankingState"
        },
        "judged": {
          "description": "Items judged so far.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total": {
          "description": "Items queued for judgement in this refresh.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "resumes_at": {
          "description": "When a usage-limit pause ends; null unless `paused`.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "message": {
          "description": "Plain text of a failure; null unless `failed` or `interrupted`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "judged",
        "total"
      ]
    },
    "RankingState": {
      "description": "State of the LLM ranking (plan §B.3); the last four end it and leave the refresh `finished`.",
      "oneOf": [
        {
          "description": "Queued behind a review analysis that holds the LLM credential.",
          "type": "string",
          "const": "waiting_for_analysis"
        },
        {
          "description": "Judging.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Paused by the provider's usage limit; continues by itself at `resumes_at`.",
          "type": "string",
          "const": "paused"
        },
        {
          "description": "Failed; provisional scores stay approximate (Retry ranking).",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Stopped by a server restart (Retry ranking).",
          "type": "string",
          "const": "interrupted"
        },
        {
          "description": "Cancelled by the user (Retry ranking).",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "Done, or nothing needed judging.",
          "type": "string",
          "const": "finished"
        }
      ]
    },
    "RefreshFailure": {
      "description": "Why a refresh failed.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Cause.",
          "$ref": "#/$defs/RefreshFailureCode"
        },
        "message": {
          "description": "Plain message for the user.",
          "type": "string"
        },
        "retry_at": {
          "description": "Earliest time a new refresh can succeed (GitHub rate-limit reset); null when not limited.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "RefreshFailureCode": {
      "description": "Cause of a failed refresh.",
      "oneOf": [
        {
          "description": "GitHub's rate limit; `retry_at` is its reset.",
          "type": "string",
          "const": "github_rate_limited"
        },
        {
          "description": "GitHub failed or answered unexpectedly.",
          "type": "string",
          "const": "github_unavailable"
        },
        {
          "description": "The user's GitHub sign-in is no longer usable; sign in again.",
          "type": "string",
          "const": "sign_in_required"
        },
        {
          "description": "The refresh took longer than its limit (5 minutes).",
          "type": "string",
          "const": "timed_out"
        },
        {
          "description": "A server restart interrupted the scan.",
          "type": "string",
          "const": "interrupted"
        },
        {
          "description": "Anything else.",
          "type": "string",
          "const": "internal"
        }
      ]
    },
    "SnapshotMeta": {
      "description": "Facts of the stored snapshot besides its items.",
      "type": "object",
      "properties": {
        "refresh_id": {
          "description": "The refresh that produced it.",
          "$ref": "#/$defs/RefreshId"
        },
        "scanned_at": {
          "description": "When its scan finished.",
          "type": "string",
          "format": "date-time"
        },
        "ranked_at": {
          "description": "When its ranking finished; null while ranking or when it did not finish.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "item_counts": {
          "description": "Ranked items by kind and tier.",
          "$ref": "#/$defs/ItemCounts"
        },
        "excluded": {
          "description": "Items left out of the ranking (`exclusions.total`).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "awaiting": {
          "description": "The user's pull requests waiting on other people.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AwaitingItem"
          }
        },
        "history": {
          "description": "Dated pull request and review events of the chart window (12 weeks), across the scanned logins.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryEvent"
          }
        },
        "todos": {
          "description": "State of the MemCan TODOs.",
          "$ref": "#/$defs/TodosState"
        },
        "notes": {
          "description": "What the scan missed or approximated.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScanNote"
          }
        },
        "unreachable": {
          "description": "Configured repositories and owners the user's GitHub token cannot see (`owner/name` or `owner`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checked": {
          "description": "What the scan read before exclusion.",
          "$ref": "#/$defs/KindCounts"
        },
        "exclusions": {
          "description": "Why the rules left items out, computed with the ranking; absent only from a response without it (a server\nolder than this field), which the web shows as not recorded.",
          "anyOf": [
            {
              "$ref": "#/$defs/Exclusions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "refresh_id",
        "scanned_at",
        "item_counts",
        "excluded",
        "awaiting",
        "history",
        "todos",
        "notes",
        "unreachable",
        "checked"
      ]
    },
    "ItemCounts": {
      "description": "Ranked items by kind and tier.",
      "type": "object",
      "properties": {
        "total": {
          "description": "All ranked items.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pr": {
          "description": "Pull requests.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "issue": {
          "description": "Issues.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "todo": {
          "description": "MemCan TODOs.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "p0": {
          "description": "Tier P0 (alarms).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "p1": {
          "description": "Tier P1.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "p2": {
          "description": "Tier P2.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "p3": {
          "description": "Tier P3.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "not_judged": {
          "description": "Items in the group \"Not judged yet\" (score state `unjudged`; also counted in their tier).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "pr",
        "issue",
        "todo",
        "p0",
        "p1",
        "p2",
        "p3",
        "not_judged"
      ]
    },
    "AwaitingItem": {
      "description": "A pull request of the user that waits on other people.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Display alias, e.g. `PLAT-1176`.",
          "type": "string"
        },
        "repo": {
          "description": "Repository.",
          "$ref": "#/$defs/RepoRef"
        },
        "number": {
          "description": "Pull request number.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "title": {
          "description": "Title.",
          "type": "string"
        },
        "url": {
          "description": "GitHub link, built by the server.",
          "type": "string"
        },
        "waiting_on": {
          "description": "Logins and teams (`team:<slug>`) whose review is requested.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waiting_since": {
          "description": "Since when it waits (the oldest open request).",
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "description": "Deterministic tags from scan facts (e.g. CI passing).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactTag"
          }
        },
        "total_tenths": {
          "description": "Its score in tenths, when it is also ranked.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        }
      },
      "required": [
        "id",
        "repo",
        "number",
        "title",
        "url",
        "waiting_on",
        "waiting_since",
        "tags"
      ]
    },
    "RepoRef": {
      "description": "A GitHub repository.",
      "type": "object",
      "properties": {
        "owner": {
          "description": "Owner (user or organisation) login.",
          "type": "string"
        },
        "name": {
          "description": "Repository name.",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "name"
      ]
    },
    "FactTag": {
      "description": "A deterministic tag from scan facts.",
      "type": "object",
      "properties": {
        "text": {
          "description": "Short text.",
          "type": "string"
        },
        "tip": {
          "description": "Tooltip with the underlying fact.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "tip"
      ]
    },
    "HistoryEvent": {
      "description": "A dated event for the charts.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "What happened.",
          "$ref": "#/$defs/HistoryKind"
        },
        "at": {
          "description": "When.",
          "type": "string",
          "format": "date-time"
        },
        "item_id": {
          "description": "The pull request, `owner/name#number`; one event per pull request and kind.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "at",
        "item_id"
      ]
    },
    "HistoryKind": {
      "description": "Kind of a history event; pull requests and reviews only (OD16).",
      "oneOf": [
        {
          "description": "A pull request authored by a scanned login was opened.",
          "type": "string",
          "const": "pr_opened"
        },
        {
          "description": "It was merged.",
          "type": "string",
          "const": "pr_merged"
        },
        {
          "description": "It was closed without merging.",
          "type": "string",
          "const": "pr_closed_unmerged"
        },
        {
          "description": "A scanned login submitted a review on a pull request.",
          "type": "string",
          "const": "review_given"
        }
      ]
    },
    "TodosState": {
      "description": "State of the MemCan TODOs in the snapshot.",
      "type": "object",
      "properties": {
        "status": {
          "description": "State.",
          "$ref": "#/$defs/TodosStatus"
        },
        "read_at": {
          "description": "When the TODO rows shown were read; null when none were read.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "failed_at": {
          "description": "When MemCan could not be reached; null unless `not_refreshed`.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "status"
      ]
    },
    "TodosStatus": {
      "description": "Whether the TODO rows are current.",
      "oneOf": [
        {
          "description": "Read in this refresh.",
          "type": "string",
          "const": "read"
        },
        {
          "description": "MemCan was unreachable; the rows come from an earlier snapshot.",
          "type": "string",
          "const": "not_refreshed"
        },
        {
          "description": "The user switched TODOs off.",
          "type": "string",
          "const": "off"
        },
        {
          "description": "MemCan is not configured on this server.",
          "type": "string",
          "const": "not_configured"
        }
      ]
    },
    "ScanNote": {
      "description": "Something the scan missed or approximated (plain text).",
      "type": "object",
      "properties": {
        "text": {
          "description": "The note.",
          "type": "string"
        },
        "item": {
          "description": "The item it concerns, if one.",
          "anyOf": [
            {
              "$ref": "#/$defs/ItemKey"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "text"
      ]
    },
    "ItemKey": {
      "type": "string",
      "pattern": "^(memcan~[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[A-Za-z0-9_-]{1,39}~([A-Za-z0-9_-][A-Za-z0-9._-]{0,99}|\\.[A-Za-z0-9_-][A-Za-z0-9._-]{0,98}|\\.\\.[A-Za-z0-9._-]{1,98})~(pr|issue)~([1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5]))$"
    },
    "KindCounts": {
      "description": "Counts by item kind.",
      "type": "object",
      "properties": {
        "pr": {
          "description": "Pull requests.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "issue": {
          "description": "Issues.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "todo": {
          "description": "MemCan TODOs.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "pr",
        "issue",
        "todo"
      ]
    },
    "Exclusions": {
      "description": "The items the rules left out of the ranking, counted per reason (facts only, no LLM text).",
      "type": "object",
      "properties": {
        "total": {
          "description": "All left-out items.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "counts": {
          "description": "Non-zero counts, in the order of [`ExclusionReason`].",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExclusionCount"
          }
        },
        "items": {
          "description": "With `?excluded=true` only: the items by reason, then display id, at most [`EXCLUDED_ITEMS_LIMIT`].",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ExcludedItem"
          }
        }
      },
      "required": [
        "total",
        "counts"
      ]
    },
    "ExclusionCount": {
      "description": "How many items one rule left out.",
      "type": "object",
      "properties": {
        "reason": {
          "description": "The rule.",
          "$ref": "#/$defs/ExclusionReason"
        },
        "count": {
          "description": "Items it left out.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "reason",
        "count"
      ]
    },
    "ExclusionReason": {
      "description": "The rule that left an item out of the ranking. Clients show an unknown value as a plain \"other rule\".",
      "oneOf": [
        {
          "description": "Written by an excluded author (Settings → Excluded authors).",
          "type": "string",
          "const": "excluded_author"
        },
        {
          "description": "A pull request of someone else not directed at the user, with no or only a minor change in the user's\nowned paths (Settings → Ownership policy).",
          "type": "string",
          "const": "outside_owned_areas"
        },
        {
          "description": "A draft pull request of someone else (only the user's own drafts count).",
          "type": "string",
          "const": "draft"
        },
        {
          "description": "The LLM, asked because the ownership policy could not be read, judged it outside the user's areas.",
          "type": "string",
          "const": "judged_not_eligible"
        },
        {
          "description": "The LLM merged it into another item covering the same work.",
          "type": "string",
          "const": "merged_into_another"
        }
      ]
    },
    "ExcludedItem": {
      "description": "One item the rules left out.",
      "type": "object",
      "properties": {
        "key": {
          "description": "Stable key.",
          "$ref": "#/$defs/ItemKey"
        },
        "kind": {
          "description": "Kind.",
          "$ref": "#/$defs/ItemKind"
        },
        "id": {
          "description": "Display id (`PLAT-1203`, `TODO-3fa91c2e`).",
          "type": "string"
        },
        "repo": {
          "description": "Repository; null for TODOs.",
          "anyOf": [
            {
              "$ref": "#/$defs/RepoRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "number": {
          "description": "Number; null for TODOs.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "url": {
          "description": "Link: GitHub, or the MemCan UI for a TODO when configured.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "description": "Title, plain text.",
          "type": "string"
        },
        "author": {
          "description": "Author login; null for TODOs.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "The rule.",
          "$ref": "#/$defs/ExclusionReason"
        },
        "merged_into": {
          "description": "Display id of the item it was merged into (`merged_into_another` only).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "kind",
        "id",
        "title",
        "reason"
      ]
    },
    "ItemKind": {
      "description": "Kind of a work item.",
      "oneOf": [
        {
          "description": "A GitHub pull request.",
          "type": "string",
          "const": "pr"
        },
        {
          "description": "A GitHub issue.",
          "type": "string",
          "const": "issue"
        },
        {
          "description": "A MemCan TODO.",
          "type": "string",
          "const": "todo"
        }
      ]
    },
    "ScheduleStatus": {
      "description": "The daily automatic refresh (ADR-020).",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "On or off.",
          "type": "boolean"
        },
        "time": {
          "description": "Local time of day, `HH:MM`.",
          "type": "string"
        },
        "time_zone": {
          "description": "IANA time zone; null until known (the schedule does not run without it).",
          "type": [
            "string",
            "null"
          ]
        },
        "next_run_at": {
          "description": "Next scheduled instant; null when off or without a time zone.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_run": {
          "description": "The most recent scheduled run; null before the first.",
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduledRun"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enabled",
        "time"
      ]
    },
    "ScheduledRun": {
      "description": "One scheduled run.",
      "type": "object",
      "properties": {
        "at": {
          "description": "Its scheduled instant (the configured local time on that local date).",
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "description": "What happened.",
          "$ref": "#/$defs/ScheduledOutcome"
        },
        "reason": {
          "description": "Plain reason for `skipped`, `needs_sign_in` and `failed`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "at",
        "outcome"
      ]
    },
    "ScheduledOutcome": {
      "description": "Outcome of a scheduled run.",
      "oneOf": [
        {
          "description": "A scheduled refresh was started (its result is that refresh's).",
          "type": "string",
          "const": "started"
        },
        {
          "description": "Not needed: a refresh succeeded after the scheduled time, or one was scanning (a ranking is superseded).",
          "type": "string",
          "const": "skipped"
        },
        {
          "description": "No usable GitHub sign-in; shown until a later refresh succeeds.",
          "type": "string",
          "const": "needs_sign_in"
        },
        {
          "description": "The scheduled refresh failed; shown until a later refresh succeeds.",
          "type": "string",
          "const": "failed"
        }
      ]
    }
  }
}
