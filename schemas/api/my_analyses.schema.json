{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyAnalyses",
  "description": "Response of `GET /api/v1/analyses`: the reader's own analyses (requested by them), the latest per pull\nrequest, newest first.",
  "type": "object",
  "properties": {
    "analyses": {
      "description": "The analyses, newest first.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MyAnalysis"
      }
    }
  },
  "required": [
    "analyses"
  ],
  "$defs": {
    "MyAnalysis": {
      "description": "One analysis of the reader's list, as stored.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Analysis id.",
          "$ref": "#/$defs/AnalysisId"
        },
        "pr": {
          "description": "The pull request.",
          "$ref": "#/$defs/PrRef"
        },
        "title": {
          "description": "The pull request title as last fetched (untrusted text).",
          "type": "string"
        },
        "status": {
          "description": "The stored status.",
          "$ref": "#/$defs/AnalysisStatus"
        },
        "created_at": {
          "description": "When the analysis was requested.",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "pr",
        "title",
        "status",
        "created_at"
      ]
    },
    "AnalysisId": {
      "description": "Identifier of an analysis (one per pull request, head commit and LLM language).",
      "type": "string",
      "format": "uuid"
    },
    "PrRef": {
      "description": "A pull request of a repository.",
      "type": "object",
      "properties": {
        "repo": {
          "description": "The repository.",
          "$ref": "#/$defs/RepoRef"
        },
        "number": {
          "description": "The pull request number.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "repo",
        "number"
      ]
    },
    "RepoRef": {
      "description": "A GitHub repository.",
      "type": "object",
      "properties": {
        "owner": {
          "description": "Owner (user or organisation) login.",
          "type": "string"
        },
        "name": {
          "description": "Repository name.",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "name"
      ]
    },
    "AnalysisStatus": {
      "description": "The stored status of an analysis (the `state` of [`AnalysisState`] without its details).",
      "oneOf": [
        {
          "description": "Planning flows.",
          "type": "string",
          "const": "planning"
        },
        {
          "description": "Analysing flows.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Waiting for a resume or a usage limit.",
          "type": "string",
          "const": "paused"
        },
        {
          "description": "Failed; can be retried.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "All flows analysed.",
          "type": "string",
          "const": "finished"
        },
        {
          "description": "Cancelled; partial results discarded.",
          "type": "string",
          "const": "cancelled"
        }
      ]
    }
  }
}
