{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommentsOverview",
  "description": "Response of RC2.",
  "type": "object",
  "properties": {
    "watch": {
      "description": "The reader’s watch for this pull request.",
      "anyOf": [
        {
          "$ref": "#/$defs/WatchedPr"
        },
        {
          "type": "null"
        }
      ]
    },
    "pr": {
      "description": "Pull request.",
      "$ref": "#/$defs/PrRef"
    },
    "title": {
      "description": "Title (GitHub).",
      "type": "string"
    },
    "url": {
      "description": "GitHub link.",
      "type": "string"
    },
    "head": {
      "description": "Head.",
      "$ref": "#/$defs/CommitSha"
    },
    "purpose": {
      "description": "PR purpose in one sentence (LLM), or the analysis's PR context.",
      "type": [
        "string",
        "null"
      ]
    },
    "read": {
      "description": "The last read.",
      "$ref": "#/$defs/GithubRead"
    },
    "counts": {
      "description": "Counts.",
      "$ref": "#/$defs/CommentCounts"
    },
    "rounds": {
      "description": "Rounds, oldest first.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Round"
      }
    },
    "assessment": {
      "description": "Assessment progress.",
      "$ref": "#/$defs/AssessmentProgress"
    },
    "queue": {
      "description": "Questions in order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/QueueEntry"
      }
    },
    "badge": {
      "description": "State badge.",
      "$ref": "#/$defs/PrBadgeView"
    },
    "analysis": {
      "description": "Latest analysis of this PR, if any (the view menu needs one for Flows, Files and Dependencies).",
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "pr",
    "title",
    "url",
    "head",
    "read",
    "counts",
    "rounds",
    "assessment",
    "queue",
    "badge"
  ],
  "$defs": {
    "WatchedPr": {
      "description": "A watched pull request (RW2, V6).",
      "type": "object",
      "properties": {
        "pr": {
          "description": "Pull request.",
          "$ref": "#/$defs/PrRef"
        },
        "title": {
          "description": "Title.",
          "type": "string"
        },
        "since": {
          "description": "Watching since.",
          "type": "string",
          "format": "date-time"
        },
        "last_probe_at": {
          "description": "Last probe.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_auto_pass": {
          "description": "Latest automatic assessment.",
          "anyOf": [
            {
              "$ref": "#/$defs/AutoPass"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "description": "State.",
          "$ref": "#/$defs/WatchState"
        },
        "ended_at": {
          "description": "When the watch ended (merged or closed).",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "badge": {
          "description": "State badge.",
          "$ref": "#/$defs/PrBadgeView"
        }
      },
      "required": [
        "pr",
        "title",
        "since",
        "state",
        "badge"
      ]
    },
    "PrRef": {
      "description": "A pull request of a repository.",
      "type": "object",
      "properties": {
        "repo": {
          "description": "The repository.",
          "$ref": "#/$defs/RepoRef"
        },
        "number": {
          "description": "The pull request number.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "repo",
        "number"
      ]
    },
    "RepoRef": {
      "description": "A GitHub repository.",
      "type": "object",
      "properties": {
        "owner": {
          "description": "Owner (user or organisation) login.",
          "type": "string"
        },
        "name": {
          "description": "Repository name.",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "name"
      ]
    },
    "AutoPass": {
      "description": "The latest automatic assessment.",
      "type": "object",
      "properties": {
        "at": {
          "description": "When it ended.",
          "type": "string",
          "format": "date-time"
        },
        "questions": {
          "description": "Questions waiting for a decision when it ended.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "at",
        "questions"
      ]
    },
    "WatchState": {
      "description": "State of a watch. Open enum.",
      "oneOf": [
        {
          "description": "Probed on schedule.",
          "type": "string",
          "const": "active"
        },
        {
          "description": "A pass waits for the bot's round to end.",
          "type": "string",
          "const": "waiting_for_bot_round"
        },
        {
          "description": "An assessment job is queued or running.",
          "type": "string",
          "const": "job_running"
        },
        {
          "description": "Today's automatic assessment limit is reached.",
          "type": "string",
          "const": "limit_reached"
        },
        {
          "description": "No GitHub token pair: \"sign in again\".",
          "type": "string",
          "const": "paused"
        },
        {
          "description": "The PR was merged or closed; watching ended.",
          "type": "string",
          "const": "ended"
        }
      ]
    },
    "PrBadgeView": {
      "description": "The badge with the facts behind it (tooltip).",
      "type": "object",
      "properties": {
        "badge": {
          "description": "Badge; null when none applies or inputs are unknown.",
          "anyOf": [
            {
              "$ref": "#/$defs/PrBadge"
            },
            {
              "type": "null"
            }
          ]
        },
        "facts": {
          "description": "Facts diffpilot read that select it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "description": "Inputs not known (no B5 while any is listed).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "facts",
        "missing"
      ]
    },
    "PrBadge": {
      "description": "PR state badge (plan §3.9 B1–B5); first match wins.",
      "oneOf": [
        {
          "description": "B1.",
          "type": "string",
          "const": "blocked_failing"
        },
        {
          "description": "A newer GitHub head is known and the shown Comments snapshot is from an older head.",
          "type": "string",
          "const": "github_outdated"
        },
        {
          "description": "Review items need an assessment.",
          "type": "string",
          "const": "assessment_needed"
        },
        {
          "description": "An assessment pass is queued or running.",
          "type": "string",
          "const": "assessing"
        },
        {
          "description": "B2.",
          "type": "string",
          "const": "questions_waiting"
        },
        {
          "description": "B3.",
          "type": "string",
          "const": "executing"
        },
        {
          "description": "B4.",
          "type": "string",
          "const": "waiting_for_bot_round"
        },
        {
          "description": "B5.",
          "type": "string",
          "const": "ready_to_merge"
        }
      ]
    },
    "CommitSha": {
      "description": "A full 40-character hexadecimal git commit id.",
      "type": "string"
    },
    "GithubRead": {
      "description": "The last read of the PR's threads, reviews and comments.",
      "type": "object",
      "properties": {
        "read_at": {
          "description": "Last successful read; null before the first.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "threads": {
          "description": "Threads read.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "complete": {
          "description": "Every page was read (no cap hit).",
          "type": "boolean"
        },
        "reviews": {
          "description": "Reviews read.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "comments": {
          "description": "PR-level comments read.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "failure": {
          "description": "The latest attempt failed.",
          "anyOf": [
            {
              "$ref": "#/$defs/ReadFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_read_at": {
          "description": "Next timed GitHub read, when polling is the fallback.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "threads",
        "complete",
        "reviews",
        "comments"
      ]
    },
    "ReadFailure": {
      "description": "Why the last GitHub read failed. Open enum.",
      "oneOf": [
        {
          "description": "GitHub's rate limit.",
          "type": "string",
          "const": "rate_limited"
        },
        {
          "description": "GitHub did not answer as expected.",
          "type": "string",
          "const": "unavailable"
        },
        {
          "description": "The user must sign in again.",
          "type": "string",
          "const": "sign_in_required"
        }
      ]
    },
    "CommentCounts": {
      "description": "Item counts of a PR.",
      "type": "object",
      "properties": {
        "not_a_review_point": {
          "description": "Items classified as not a review point.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "needs_you": {
          "description": "Items in the Needs you queue.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "needs_you_gates": {
          "description": "Gated items in the Needs you queue.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "imported_unseen": {
          "description": "Items with a decision imported since this reader last visited Comments.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "unresolved_threads": {
          "description": "Unresolved threads on GitHub (fact).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "undecided": {
          "description": "Undecided questions.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "asked_again": {
          "description": "Repeats asked again.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "waiting_for_agents": {
          "description": "Decisions with open or claimed effects.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "failed_effects": {
          "description": "Failed effects.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "outside": {
          "description": "Items resolved outside diffpilot.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total": {
          "description": "All items.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "not_a_review_point",
        "needs_you",
        "needs_you_gates",
        "unresolved_threads",
        "undecided",
        "asked_again",
        "waiting_for_agents",
        "failed_effects",
        "outside",
        "total"
      ]
    },
    "Round": {
      "description": "A bot round: a thepastaclaw review with `phase=final sha=<head>` (spike S13-1 R1).",
      "type": "object",
      "properties": {
        "number": {
          "description": "1-based.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "url": {
          "description": "The round's review (GitHub link).",
          "type": "string"
        },
        "head": {
          "description": "Head reviewed.",
          "$ref": "#/$defs/CommitSha"
        },
        "finished_at": {
          "description": "Submitted.",
          "type": "string",
          "format": "date-time"
        },
        "verdict": {
          "description": "The bot's review state as GitHub reports it (`CHANGES_REQUESTED`, `APPROVED`, `DISMISSED`, …).",
          "type": "string"
        },
        "new": {
          "description": "Items first seen in this round.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "still_open": {
          "description": "Items still open at its end.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "carried": {
          "description": "Repeats carried.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "asked_again": {
          "description": "Repeats asked again.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "undecided": {
          "description": "Undecided items.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "decisions": {
          "description": "Decisions by kind.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/KindCount"
          }
        }
      },
      "required": [
        "number",
        "url",
        "head",
        "finished_at",
        "verdict",
        "new",
        "still_open",
        "carried",
        "asked_again",
        "undecided",
        "decisions"
      ]
    },
    "KindCount": {
      "description": "Decisions of one kind.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Kind.",
          "$ref": "#/$defs/DecisionKind"
        },
        "count": {
          "description": "Count.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "count"
      ]
    },
    "DecisionKind": {
      "description": "A review decision or an internal mark accepted by the decide routes.",
      "oneOf": [
        {
          "description": "D1: resolve, already fixed.",
          "type": "string",
          "const": "resolve"
        },
        {
          "description": "D2: fix in this pull request.",
          "type": "string",
          "const": "fix_here"
        },
        {
          "description": "D3: reject (with a reason); D8 with a `blocker_gate` override.",
          "type": "string",
          "const": "reject"
        },
        {
          "description": "D4: handled in an existing pull request.",
          "type": "string",
          "const": "handled_in_pr"
        },
        {
          "description": "D5: create a follow-up pull request.",
          "type": "string",
          "const": "follow_up_pr"
        },
        {
          "description": "Create a follow-up issue in the pull request's repository.",
          "type": "string",
          "const": "follow_up_issue"
        },
        {
          "description": "D6: upstream issue (link or create).",
          "type": "string",
          "const": "upstream_issue"
        },
        {
          "description": "D7: TODO, out of scope for this pull request.",
          "type": "string",
          "const": "todo"
        },
        {
          "description": "P1: merge now, remaining items become follow-ups.",
          "type": "string",
          "const": "merge_with_follow_ups"
        },
        {
          "description": "P2: another round.",
          "type": "string",
          "const": "another_round"
        },
        {
          "description": "P3: dismiss the listed stale bot reviews.",
          "type": "string",
          "const": "dismiss_stale_reviews"
        },
        {
          "description": "P4: keep the reviews.",
          "type": "string",
          "const": "keep_reviews"
        },
        {
          "description": "Record an internal mark without effects.",
          "type": "string",
          "const": "not_a_review_point"
        }
      ]
    },
    "AssessmentProgress": {
      "description": "Assessment progress of a PR (\"LLM assessment running: 4 of 9 comments\").",
      "type": "object",
      "properties": {
        "in_pass": {
          "description": "Items in the live pass input.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "waiting": {
          "description": "Items waiting for the next pass.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "since": {
          "description": "When the live pass started.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "running": {
          "description": "A pass is queued or running.",
          "type": "boolean"
        },
        "assessed": {
          "description": "Items assessed at the current head.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total": {
          "description": "Items needing an assessment.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "limited": {
          "description": "Items left out by the daily limit.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "head": {
          "description": "Head of the latest pass.",
          "anyOf": [
            {
              "$ref": "#/$defs/CommitSha"
            },
            {
              "type": "null"
            }
          ]
        },
        "at": {
          "description": "End of the latest pass.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "running",
        "assessed",
        "total",
        "limited"
      ]
    },
    "QueueEntry": {
      "description": "One question in the queue: a single item or a group.",
      "type": "object",
      "properties": {
        "item_nos": {
          "description": "Items, `C<no>`; two or more for a group.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "reason": {
          "description": "Reason.",
          "$ref": "#/$defs/QueueReason"
        },
        "skipped": {
          "description": "The reader skipped it at its current revision and it belongs in Skipped. Absent when active.",
          "type": "boolean"
        }
      },
      "required": [
        "item_nos",
        "reason"
      ]
    },
    "QueueReason": {
      "description": "Why an entry is at its place in the queue (plan §2.4 order). Open enum.",
      "oneOf": [
        {
          "description": "1. PR-level question.",
          "type": "string",
          "const": "pr_question"
        },
        {
          "description": "2. Repeat asked again.",
          "type": "string",
          "const": "asked_again"
        },
        {
          "description": "3. Answer to the owner's question.",
          "type": "string",
          "const": "answered"
        },
        {
          "description": "4. Gate item.",
          "type": "string",
          "const": "gate"
        },
        {
          "description": "5. Marked Blocking by the reviewer.",
          "type": "string",
          "const": "blocking"
        },
        {
          "description": "6. Other single item.",
          "type": "string",
          "const": "single"
        },
        {
          "description": "7. Group.",
          "type": "string",
          "const": "group"
        }
      ]
    },
    "AnalysisId": {
      "description": "Identifier of an analysis (one per pull request, head commit and LLM language).",
      "type": "string",
      "format": "uuid"
    }
  }
}
