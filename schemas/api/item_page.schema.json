{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemPage",
  "description": "Response of `GET /api/v1/dashboard/items`: ranked items of the latest snapshot, in rank order.",
  "type": "object",
  "properties": {
    "mentions": {
      "description": "Unanswered, unhidden mentions on the first page only; empty on cursor pages.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Mention"
      },
      "default": []
    },
    "mention_coverage": {
      "description": "Mention reads omitted in this snapshot, independent of item filters and pagination.",
      "$ref": "#/$defs/MentionCoverage",
      "default": {
        "unchecked_items": 0,
        "unchecked_logins": [],
        "timed_out_logins": []
      }
    },
    "revision": {
      "description": "The summary's `revision` the page belongs to.",
      "type": "string"
    },
    "items": {
      "description": "Items of this page.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkItem"
      }
    },
    "next_cursor": {
      "description": "Cursor of the next page; null on the last.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "revision",
    "items"
  ],
  "$defs": {
    "Mention": {
      "description": "A request addressed to a scanned login, outside the ranked list.",
      "type": "object",
      "properties": {
        "partly_read": {
          "description": "Only a bounded part of this conversation was read.",
          "type": "boolean",
          "default": false
        },
        "id": {
          "description": "Stable opaque identity of this post on this item (used by Hide).",
          "type": "string"
        },
        "item_key": {
          "description": "The containing item.",
          "$ref": "#/$defs/ItemKey"
        },
        "kind": {
          "description": "Pull request or issue.",
          "$ref": "#/$defs/GithubKind"
        },
        "repo": {
          "description": "Repository.",
          "$ref": "#/$defs/RepoRef"
        },
        "number": {
          "description": "Item number.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "title": {
          "description": "Item title, plain text.",
          "type": "string"
        },
        "author": {
          "description": "Mentioning author; a deleted account is shown as `ghost`.",
          "type": "string"
        },
        "is_bot": {
          "description": "GitHub Bot type, [bot] suffix or the user's known bots.",
          "type": "boolean"
        },
        "created_at": {
          "description": "When the mentioning post was created.",
          "type": "string",
          "format": "date-time"
        },
        "text": {
          "description": "One line of the mentioning text, plain text only.",
          "type": "string"
        },
        "url": {
          "description": "Server-built GitHub link to the mentioning post.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "item_key",
        "kind",
        "repo",
        "number",
        "title",
        "author",
        "is_bot",
        "created_at",
        "text",
        "url"
      ]
    },
    "ItemKey": {
      "type": "string",
      "pattern": "^(memcan~[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[A-Za-z0-9_-]{1,39}~([A-Za-z0-9_-][A-Za-z0-9._-]{0,99}|\\.[A-Za-z0-9_-][A-Za-z0-9._-]{0,98}|\\.\\.[A-Za-z0-9._-]{1,98})~(pr|issue)~([1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5]))$"
    },
    "GithubKind": {
      "description": "GitHub item kinds of the list filter `kind`.",
      "oneOf": [
        {
          "description": "Pull requests.",
          "type": "string",
          "const": "pr"
        },
        {
          "description": "Issues.",
          "type": "string",
          "const": "issue"
        }
      ]
    },
    "RepoRef": {
      "description": "A GitHub repository.",
      "type": "object",
      "properties": {
        "owner": {
          "description": "Owner (user or organisation) login.",
          "type": "string"
        },
        "name": {
          "description": "Repository name.",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "name"
      ]
    },
    "MentionCoverage": {
      "description": "Missing mention reads; zero items does not imply that every login was searched.",
      "type": "object",
      "properties": {
        "unchecked_items": {
          "description": "Real candidates not checked because of the read budget, deadline or read failure.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "unchecked_logins": {
          "description": "Logins whose mention search was unavailable; fallback covers only mention-only issues.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timed_out_logins": {
          "description": "Logins whose PR mention search exceeded its request budget.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "unchecked_items",
        "unchecked_logins",
        "timed_out_logins"
      ]
    },
    "WorkItem": {
      "description": "One ranked item.",
      "type": "object",
      "properties": {
        "judgement": {
          "description": "Judgement state when this item can be judged.",
          "anyOf": [
            {
              "$ref": "#/$defs/Judgement"
            },
            {
              "type": "null"
            }
          ]
        },
        "live": {
          "description": "Whether GitHub App webhooks update this repository.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "stack": {
          "description": "Position of this pull request within a stack.",
          "anyOf": [
            {
              "$ref": "#/$defs/Stack"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_base": {
          "description": "The pull request's base branch when it matches a repository release pattern, configured or otherwise built-in.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Display alias, e.g. `PLAT-1187` or `TODO-3fa91c2e`.",
          "type": "string"
        },
        "key": {
          "description": "Stable, unique, URL-safe key.",
          "$ref": "#/$defs/ItemKey"
        },
        "kind": {
          "description": "Kind.",
          "$ref": "#/$defs/ItemKind"
        },
        "repo": {
          "description": "Repository; null for TODOs (their MemCan project is a tag).",
          "anyOf": [
            {
              "$ref": "#/$defs/RepoRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "number": {
          "description": "Pull request or issue number; null for TODOs.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "title": {
          "description": "Title.",
          "type": "string"
        },
        "url": {
          "description": "Link built by the server (GitHub, or the MemCan UI); null for a TODO without a configured MemCan UI.",
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "description": "Author login; null for TODOs.",
          "type": [
            "string",
            "null"
          ]
        },
        "private": {
          "description": "From a private repository (shown only to this user).",
          "type": "boolean"
        },
        "updated_at": {
          "description": "Pull requests and issues: GitHub `updatedAt`. TODOs: when the dashboard first saw the current values of the\nfields of plan §G (MemCan has no `updated_at`).",
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "description": "Deterministic tags from scan facts.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactTag"
          }
        },
        "change_size": {
          "description": "Size mark of a pull request's full diff (display only); absent for issues, TODOs and unknown totals.",
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeSizeMark"
            },
            {
              "type": "null"
            }
          ]
        },
        "facts": {
          "description": "Deterministic facts from the scan.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "score": {
          "description": "Score with its parts.",
          "$ref": "#/$defs/ItemScore"
        },
        "llm": {
          "description": "LLM-written text; null before the first judgement.",
          "anyOf": [
            {
              "$ref": "#/$defs/ItemText"
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "description": "The user's diffpilot analysis of this pull request, read at request time; null when none.",
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewLink"
            },
            {
              "type": "null"
            }
          ]
        },
        "comments": {
          "description": "Review comments diffpilot read for this pull request (Comments), counted at request time; absent before\ndiffpilot's first successful read of them.",
          "anyOf": [
            {
              "$ref": "#/$defs/CommentTally"
            },
            {
              "type": "null"
            }
          ]
        },
        "watched": {
          "description": "The user watches this pull request (RW1), read at request time; with `comments` absent its comments were\nnot read yet.",
          "type": "boolean"
        },
        "plugin_notes": {
          "description": "Current statements of dashboard plug-ins about this pull request (ADR-022); absent when none.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginNote"
          }
        }
      },
      "required": [
        "id",
        "key",
        "kind",
        "title",
        "private",
        "updated_at",
        "tags",
        "facts",
        "score"
      ]
    },
    "Judgement": {
      "description": "Judgement state and its evidence.",
      "type": "object",
      "properties": {
        "state": {
          "description": "State of the item's judgement.",
          "$ref": "#/$defs/JudgementState"
        },
        "judged_at": {
          "description": "When the existing judgement was made.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "outdated_because": {
          "description": "Which input to the existing judgement changed.",
          "anyOf": [
            {
              "$ref": "#/$defs/OutdatedBecause"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state"
      ]
    },
    "JudgementState": {
      "description": "Whether an item has a current judgement or is waiting for one.",
      "oneOf": [
        {
          "description": "The judged facts and prompt are current.",
          "type": "string",
          "const": "current"
        },
        {
          "description": "The facts or prompt changed since the judgement.",
          "type": "string",
          "const": "outdated"
        },
        {
          "description": "A live ranking can judge this previously unjudged item.",
          "type": "string",
          "const": "queued"
        },
        {
          "description": "A re-judgement is requested and a ranking is live.",
          "type": "string",
          "const": "judging"
        },
        {
          "description": "No judgement was made.",
          "type": "string",
          "const": "not_judged"
        },
        {
          "description": "The latest ranking left the item unjudged at a cap.",
          "type": "string",
          "const": "capped"
        }
      ]
    },
    "OutdatedBecause": {
      "description": "Input that made an existing judgement outdated.",
      "oneOf": [
        {
          "description": "One or more judged facts changed.",
          "type": "string",
          "const": "facts_changed"
        },
        {
          "description": "The ranking prompt changed.",
          "type": "string",
          "const": "prompt_changed"
        }
      ]
    },
    "Stack": {
      "description": "Position and dependent pull requests of an item in a stack.",
      "type": "object",
      "properties": {
        "position": {
          "description": "Position of the pull request.",
          "$ref": "#/$defs/StackPosition"
        },
        "size": {
          "description": "Number of pull requests in the stack.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "dependents": {
          "description": "Numbers of open pull requests above this one, in stack order.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "required": [
        "position",
        "size",
        "dependents"
      ]
    },
    "StackPosition": {
      "description": "Position of a pull request in a stack.",
      "oneOf": [
        {
          "description": "Lowest open layer with open dependents.",
          "type": "string",
          "const": "bottom"
        },
        {
          "description": "With a parent and open dependents.",
          "type": "string",
          "const": "middle"
        },
        {
          "description": "With no open dependents.",
          "type": "string",
          "const": "top"
        }
      ]
    },
    "ItemKind": {
      "description": "Kind of a work item.",
      "oneOf": [
        {
          "description": "A GitHub pull request.",
          "type": "string",
          "const": "pr"
        },
        {
          "description": "A GitHub issue.",
          "type": "string",
          "const": "issue"
        },
        {
          "description": "A MemCan TODO.",
          "type": "string",
          "const": "todo"
        }
      ]
    },
    "FactTag": {
      "description": "A deterministic tag from scan facts.",
      "type": "object",
      "properties": {
        "filter": {
          "description": "Filter for items with this fact.",
          "anyOf": [
            {
              "$ref": "#/$defs/FactFilter"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "description": "Short text.",
          "type": "string"
        },
        "tip": {
          "description": "Tooltip with the underlying fact.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "tip"
      ]
    },
    "FactFilter": {
      "description": "Selects items with a deterministic fact.",
      "type": "object",
      "properties": {
        "key": {
          "description": "Stable key for the fact kind and its value where applicable.",
          "type": "string"
        },
        "label": {
          "description": "Label shown on the filter chip.",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ]
    },
    "ChangeSizeMark": {
      "description": "A pull request's size mark with its evidence (a scan fact, not a score input).",
      "type": "object",
      "properties": {
        "size": {
          "description": "The mark.",
          "$ref": "#/$defs/SizeMark"
        },
        "additions": {
          "description": "Added lines of the full diff.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "deletions": {
          "description": "Removed lines of the full diff.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "size",
        "additions",
        "deletions"
      ]
    },
    "SizeMark": {
      "description": "Size mark of a pull request: a fixed table of changed lines (additions + deletions), plan §C.2 K16.",
      "oneOf": [
        {
          "description": "Fewer than 150 changed lines.",
          "type": "string",
          "const": "tiny"
        },
        {
          "description": "150 to 499 changed lines.",
          "type": "string",
          "const": "small"
        },
        {
          "description": "500 to 2999 changed lines.",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "3000 to 9999 changed lines.",
          "type": "string",
          "const": "large"
        },
        {
          "description": "10 000 changed lines or more.",
          "type": "string",
          "const": "huge"
        }
      ]
    },
    "Fact": {
      "description": "A labelled scan fact.",
      "type": "object",
      "properties": {
        "label": {
          "description": "Label.",
          "type": "string"
        },
        "value": {
          "description": "Value.",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ]
    },
    "ItemScore": {
      "description": "Score of an item: the sum of its parts, in tenths of a point.",
      "type": "object",
      "properties": {
        "total_tenths": {
          "description": "Sum of the parts' points, in tenths.",
          "type": "integer",
          "format": "int32"
        },
        "state": {
          "description": "Whether every part is final.",
          "$ref": "#/$defs/ScoreState"
        },
        "tier": {
          "description": "Tier, computed by the server (P0 = alarm; otherwise P1 ≥ 65, P2 35–<65, P3 < 35 points).",
          "$ref": "#/$defs/Tier"
        },
        "parts": {
          "description": "The components, in display order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScorePart"
          }
        }
      },
      "required": [
        "total_tenths",
        "state",
        "tier",
        "parts"
      ]
    },
    "ScoreState": {
      "description": "Whether a score is final.",
      "oneOf": [
        {
          "description": "Every part is final.",
          "type": "string",
          "const": "final"
        },
        {
          "description": "Some LLM part is carried over from before a change, or a computed default awaits confirmation (`~N`).",
          "type": "string",
          "const": "provisional"
        },
        {
          "description": "New item the LLM has not judged; computed parts plus named estimates (group \"Not judged yet\").",
          "type": "string",
          "const": "unjudged"
        }
      ]
    },
    "Tier": {
      "description": "Priority tier.",
      "oneOf": [
        {
          "description": "Alarm, independent of the score.",
          "type": "string",
          "const": "p0"
        },
        {
          "description": "Score ≥ 65.",
          "type": "string",
          "const": "p1"
        },
        {
          "description": "Score 35–<65.",
          "type": "string",
          "const": "p2"
        },
        {
          "description": "Score < 35.",
          "type": "string",
          "const": "p3"
        }
      ]
    },
    "ScorePart": {
      "description": "One score component.",
      "type": "object",
      "properties": {
        "component": {
          "description": "Which component.",
          "$ref": "#/$defs/ScoreComponent"
        },
        "points_tenths": {
          "description": "Points in tenths; null while pending.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "source": {
          "description": "Who decides it.",
          "$ref": "#/$defs/PartSource"
        },
        "status": {
          "description": "How the value was reached.",
          "$ref": "#/$defs/PartStatus"
        },
        "basis": {
          "description": "Plain basis of the value (an estimate names its rule).",
          "type": "string"
        }
      },
      "required": [
        "component",
        "source",
        "status",
        "basis"
      ]
    },
    "ScoreComponent": {
      "description": "The twelve score components (daily-priorities `scoreParts`).",
      "oneOf": [
        {
          "description": "How far the work has advanced.",
          "type": "string",
          "const": "advancement"
        },
        {
          "description": "Severity of a pre-existing defect it addresses.",
          "type": "string",
          "const": "defect_severity"
        },
        {
          "description": "Work it unblocks.",
          "type": "string",
          "const": "unblocks"
        },
        {
          "description": "A human waiting on the user.",
          "type": "string",
          "const": "human_waiting"
        },
        {
          "description": "Recency of the last change.",
          "type": "string",
          "const": "recency"
        },
        {
          "description": "Impact of the change.",
          "type": "string",
          "const": "change_impact"
        },
        {
          "description": "How close it is to done.",
          "type": "string",
          "const": "completion"
        },
        {
          "description": "Size of the change (smaller scores higher).",
          "type": "string",
          "const": "change_size"
        },
        {
          "description": "Confirmed production defect or release blocker.",
          "type": "string",
          "const": "urgency_bonus"
        },
        {
          "description": "Blocked by something open.",
          "type": "string",
          "const": "blocked_penalty"
        },
        {
          "description": "Targets the default branch.",
          "type": "string",
          "const": "default_branch_bonus"
        },
        {
          "description": "Milestone of the current or next release.",
          "type": "string",
          "const": "milestone_bonus"
        }
      ]
    },
    "PartSource": {
      "description": "Who decides a part.",
      "oneOf": [
        {
          "description": "Computed from scan facts by the server.",
          "type": "string",
          "const": "computed"
        },
        {
          "description": "Judged by the LLM.",
          "type": "string",
          "const": "llm"
        },
        {
          "description": "Does not apply to this kind of item (contributes 0).",
          "type": "string",
          "const": "not_applicable"
        }
      ]
    },
    "PartStatus": {
      "description": "How a part's value was reached.",
      "oneOf": [
        {
          "description": "Computed from scan facts.",
          "type": "string",
          "const": "computed"
        },
        {
          "description": "Judged by the LLM for the current judged inputs.",
          "type": "string",
          "const": "judged"
        },
        {
          "description": "The LLM replaced a computed default, with a stated basis.",
          "type": "string",
          "const": "overridden"
        },
        {
          "description": "Carried over from a judgement made before the item changed; re-judged later.",
          "type": "string",
          "const": "inherited"
        },
        {
          "description": "A named constant estimate until the LLM judges the item.",
          "type": "string",
          "const": "estimated"
        },
        {
          "description": "Not known yet.",
          "type": "string",
          "const": "pending"
        }
      ]
    },
    "ItemText": {
      "description": "LLM-written text of an item (shown with the \"LLM\" tag).",
      "type": "object",
      "properties": {
        "why": {
          "description": "Why it ranks where it does.",
          "type": "string"
        },
        "next": {
          "description": "The next action.",
          "type": "string"
        },
        "alarm": {
          "description": "Reason of a P0 alarm; null when none.",
          "type": [
            "string",
            "null"
          ]
        },
        "judged_at": {
          "description": "When it was judged.",
          "type": "string",
          "format": "date-time"
        },
        "inherited": {
          "description": "Carried over from before the item changed.\nSuperseded by `WorkItem.judgement`.",
          "type": "boolean"
        },
        "also_keys": {
          "description": "Keys of items the LLM merged into this one (chosen only from server-suggested pairs).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemKey"
          }
        }
      },
      "required": [
        "why",
        "next",
        "judged_at",
        "inherited",
        "also_keys"
      ]
    },
    "ReviewLink": {
      "description": "The user's diffpilot analysis of a pull request item.",
      "type": "object",
      "properties": {
        "analysis_id": {
          "description": "The newest analysis of the pull request.",
          "$ref": "#/$defs/AnalysisId"
        },
        "analysed_head": {
          "description": "Head commit it analysed.",
          "$ref": "#/$defs/CommitSha"
        },
        "head_moved": {
          "description": "The pull request head moved since.",
          "type": "boolean"
        },
        "has_my_state": {
          "description": "The user has saved review state on it.",
          "type": "boolean"
        }
      },
      "required": [
        "analysis_id",
        "analysed_head",
        "head_moved",
        "has_my_state"
      ]
    },
    "AnalysisId": {
      "description": "Identifier of an analysis (one per pull request, head commit and LLM language).",
      "type": "string",
      "format": "uuid"
    },
    "CommitSha": {
      "description": "A full 40-character hexadecimal git commit id.",
      "type": "string"
    },
    "CommentTally": {
      "description": "Counts of a pull request's review comments in Comments (plan docs/review-workflow-plan.md §2.1): threads,\nreview-body and PR-comment items of the last read, without PR-level questions and items the read no longer\nproduces.",
      "type": "object",
      "properties": {
        "total": {
          "description": "Comments in any state.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "needs_you": {
          "description": "Those waiting for a decision: the Needs you list of Comments.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "needs_you"
      ]
    },
    "PluginNote": {
      "description": "An external statement of a dashboard plug-in about a pull request (ADR-022): attributed to its source, plain\ntext, never a diffpilot fact or verdict.",
      "type": "object",
      "properties": {
        "plugin": {
          "description": "Plug-in id, e.g. `pr-hygiene`.",
          "type": "string"
        },
        "source": {
          "description": "Name shown before the statement, e.g. `PR Hygiene`.",
          "type": "string"
        },
        "url": {
          "description": "Evidence: the source's record of the pull request, built by the server.",
          "type": "string"
        },
        "as_of": {
          "description": "When the source produced the data.",
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "description": "Headline (PR Hygiene: the next action).",
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "description": "Further points (PR Hygiene: the blockers).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "facts": {
          "description": "Labelled values (PR Hygiene: stage, whose move, lateness).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        }
      },
      "required": [
        "plugin",
        "source",
        "url",
        "as_of",
        "details",
        "facts"
      ]
    }
  }
}
