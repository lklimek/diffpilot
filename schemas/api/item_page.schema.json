{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemPage",
  "description": "Response of `GET /api/v1/dashboard/items`: ranked items of the latest snapshot, in rank order.",
  "type": "object",
  "properties": {
    "revision": {
      "description": "The summary's `revision` the page belongs to.",
      "type": "string"
    },
    "items": {
      "description": "Items of this page.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkItem"
      }
    },
    "next_cursor": {
      "description": "Cursor of the next page; null on the last.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "revision",
    "items"
  ],
  "$defs": {
    "WorkItem": {
      "description": "One ranked item.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Display alias, e.g. `PLAT-1187` or `TODO-3fa91c2e`.",
          "type": "string"
        },
        "key": {
          "description": "Stable, unique, URL-safe key.",
          "$ref": "#/$defs/ItemKey"
        },
        "kind": {
          "description": "Kind.",
          "$ref": "#/$defs/ItemKind"
        },
        "repo": {
          "description": "Repository; null for TODOs (their MemCan project is a tag).",
          "anyOf": [
            {
              "$ref": "#/$defs/RepoRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "number": {
          "description": "Pull request or issue number; null for TODOs.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "title": {
          "description": "Title.",
          "type": "string"
        },
        "url": {
          "description": "Link built by the server (GitHub, or the MemCan UI); null for a TODO without a configured MemCan UI.",
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "description": "Author login; null for TODOs.",
          "type": [
            "string",
            "null"
          ]
        },
        "private": {
          "description": "From a private repository (shown only to this user).",
          "type": "boolean"
        },
        "updated_at": {
          "description": "Pull requests and issues: GitHub `updatedAt`. TODOs: when the dashboard first saw the current values of the\nfields of plan §G (MemCan has no `updated_at`).",
          "type": "string",
          "format": "date-time"
        },
        "tags": {
          "description": "Deterministic tags from scan facts.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactTag"
          }
        },
        "change_size": {
          "description": "Size mark of a pull request's full diff (display only); absent for issues, TODOs and unknown totals.",
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeSizeMark"
            },
            {
              "type": "null"
            }
          ]
        },
        "facts": {
          "description": "Deterministic facts from the scan.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "score": {
          "description": "Score with its parts.",
          "$ref": "#/$defs/ItemScore"
        },
        "llm": {
          "description": "LLM-written text; null before the first judgement.",
          "anyOf": [
            {
              "$ref": "#/$defs/ItemText"
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "description": "The user's smart-review analysis of this pull request, read at request time; null when none.",
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewLink"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "key",
        "kind",
        "title",
        "private",
        "updated_at",
        "tags",
        "facts",
        "score"
      ]
    },
    "ItemKey": {
      "type": "string",
      "pattern": "^(memcan~[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[A-Za-z0-9_-]{1,39}~([A-Za-z0-9_-][A-Za-z0-9._-]{0,99}|\\.[A-Za-z0-9_-][A-Za-z0-9._-]{0,98}|\\.\\.[A-Za-z0-9._-]{1,98})~(pr|issue)~([1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5]))$"
    },
    "ItemKind": {
      "description": "Kind of a work item.",
      "oneOf": [
        {
          "description": "A GitHub pull request.",
          "type": "string",
          "const": "pr"
        },
        {
          "description": "A GitHub issue.",
          "type": "string",
          "const": "issue"
        },
        {
          "description": "A MemCan TODO.",
          "type": "string",
          "const": "todo"
        }
      ]
    },
    "RepoRef": {
      "description": "A GitHub repository.",
      "type": "object",
      "properties": {
        "owner": {
          "description": "Owner (user or organisation) login.",
          "type": "string"
        },
        "name": {
          "description": "Repository name.",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "name"
      ]
    },
    "FactTag": {
      "description": "A deterministic tag from scan facts.",
      "type": "object",
      "properties": {
        "text": {
          "description": "Short text.",
          "type": "string"
        },
        "tip": {
          "description": "Tooltip with the underlying fact.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "tip"
      ]
    },
    "ChangeSizeMark": {
      "description": "A pull request's size mark with its evidence (a scan fact, not a score input).",
      "type": "object",
      "properties": {
        "size": {
          "description": "The mark.",
          "$ref": "#/$defs/SizeMark"
        },
        "additions": {
          "description": "Added lines of the full diff.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "deletions": {
          "description": "Removed lines of the full diff.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "size",
        "additions",
        "deletions"
      ]
    },
    "SizeMark": {
      "description": "Size mark of a pull request: a fixed table of changed lines (additions + deletions), plan §C.2 K16.",
      "oneOf": [
        {
          "description": "Fewer than 150 changed lines.",
          "type": "string",
          "const": "tiny"
        },
        {
          "description": "150 to 499 changed lines.",
          "type": "string",
          "const": "small"
        },
        {
          "description": "500 to 2999 changed lines.",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "3000 to 9999 changed lines.",
          "type": "string",
          "const": "large"
        },
        {
          "description": "10 000 changed lines or more.",
          "type": "string",
          "const": "huge"
        }
      ]
    },
    "Fact": {
      "description": "A labelled scan fact.",
      "type": "object",
      "properties": {
        "label": {
          "description": "Label.",
          "type": "string"
        },
        "value": {
          "description": "Value.",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ]
    },
    "ItemScore": {
      "description": "Score of an item: the sum of its parts, in tenths of a point.",
      "type": "object",
      "properties": {
        "total_tenths": {
          "description": "Sum of the parts' points, in tenths.",
          "type": "integer",
          "format": "int32"
        },
        "state": {
          "description": "Whether every part is final.",
          "$ref": "#/$defs/ScoreState"
        },
        "tier": {
          "description": "Tier, computed by the server (P0 = alarm; otherwise P1 ≥ 65, P2 35–<65, P3 < 35 points).",
          "$ref": "#/$defs/Tier"
        },
        "parts": {
          "description": "The components, in display order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScorePart"
          }
        }
      },
      "required": [
        "total_tenths",
        "state",
        "tier",
        "parts"
      ]
    },
    "ScoreState": {
      "description": "Whether a score is final.",
      "oneOf": [
        {
          "description": "Every part is final.",
          "type": "string",
          "const": "final"
        },
        {
          "description": "Some LLM part is carried over from before a change, or a computed default awaits confirmation (`~N`).",
          "type": "string",
          "const": "provisional"
        },
        {
          "description": "New item the LLM has not judged; computed parts plus named estimates (group \"Not judged yet\").",
          "type": "string",
          "const": "unjudged"
        }
      ]
    },
    "Tier": {
      "description": "Priority tier.",
      "oneOf": [
        {
          "description": "Alarm, independent of the score.",
          "type": "string",
          "const": "p0"
        },
        {
          "description": "Score ≥ 65.",
          "type": "string",
          "const": "p1"
        },
        {
          "description": "Score 35–<65.",
          "type": "string",
          "const": "p2"
        },
        {
          "description": "Score < 35.",
          "type": "string",
          "const": "p3"
        }
      ]
    },
    "ScorePart": {
      "description": "One score component.",
      "type": "object",
      "properties": {
        "component": {
          "description": "Which component.",
          "$ref": "#/$defs/ScoreComponent"
        },
        "points_tenths": {
          "description": "Points in tenths; null while pending.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "source": {
          "description": "Who decides it.",
          "$ref": "#/$defs/PartSource"
        },
        "status": {
          "description": "How the value was reached.",
          "$ref": "#/$defs/PartStatus"
        },
        "basis": {
          "description": "Plain basis of the value (an estimate names its rule).",
          "type": "string"
        }
      },
      "required": [
        "component",
        "source",
        "status",
        "basis"
      ]
    },
    "ScoreComponent": {
      "description": "The twelve score components (daily-priorities `scoreParts`).",
      "oneOf": [
        {
          "description": "How far the work has advanced.",
          "type": "string",
          "const": "advancement"
        },
        {
          "description": "Severity of a pre-existing defect it addresses.",
          "type": "string",
          "const": "defect_severity"
        },
        {
          "description": "Work it unblocks.",
          "type": "string",
          "const": "unblocks"
        },
        {
          "description": "A human waiting on the user.",
          "type": "string",
          "const": "human_waiting"
        },
        {
          "description": "Recency of the last change.",
          "type": "string",
          "const": "recency"
        },
        {
          "description": "Impact of the change.",
          "type": "string",
          "const": "change_impact"
        },
        {
          "description": "How close it is to done.",
          "type": "string",
          "const": "completion"
        },
        {
          "description": "Size of the change (smaller scores higher).",
          "type": "string",
          "const": "change_size"
        },
        {
          "description": "Confirmed production defect or release blocker.",
          "type": "string",
          "const": "urgency_bonus"
        },
        {
          "description": "Blocked by something open.",
          "type": "string",
          "const": "blocked_penalty"
        },
        {
          "description": "Targets the default branch.",
          "type": "string",
          "const": "default_branch_bonus"
        },
        {
          "description": "Milestone of the current or next release.",
          "type": "string",
          "const": "milestone_bonus"
        }
      ]
    },
    "PartSource": {
      "description": "Who decides a part.",
      "oneOf": [
        {
          "description": "Computed from scan facts by the server.",
          "type": "string",
          "const": "computed"
        },
        {
          "description": "Judged by the LLM.",
          "type": "string",
          "const": "llm"
        },
        {
          "description": "Does not apply to this kind of item (contributes 0).",
          "type": "string",
          "const": "not_applicable"
        }
      ]
    },
    "PartStatus": {
      "description": "How a part's value was reached.",
      "oneOf": [
        {
          "description": "Computed from scan facts.",
          "type": "string",
          "const": "computed"
        },
        {
          "description": "Judged by the LLM for the current judged inputs.",
          "type": "string",
          "const": "judged"
        },
        {
          "description": "The LLM replaced a computed default, with a stated basis.",
          "type": "string",
          "const": "overridden"
        },
        {
          "description": "Carried over from a judgement made before the item changed; re-judged later.",
          "type": "string",
          "const": "inherited"
        },
        {
          "description": "A named constant estimate until the LLM judges the item.",
          "type": "string",
          "const": "estimated"
        },
        {
          "description": "Not known yet.",
          "type": "string",
          "const": "pending"
        }
      ]
    },
    "ItemText": {
      "description": "LLM-written text of an item (shown with the \"LLM\" tag).",
      "type": "object",
      "properties": {
        "why": {
          "description": "Why it ranks where it does.",
          "type": "string"
        },
        "next": {
          "description": "The next action.",
          "type": "string"
        },
        "alarm": {
          "description": "Reason of a P0 alarm; null when none.",
          "type": [
            "string",
            "null"
          ]
        },
        "judged_at": {
          "description": "When it was judged.",
          "type": "string",
          "format": "date-time"
        },
        "inherited": {
          "description": "Carried over from before the item changed.",
          "type": "boolean"
        },
        "also_keys": {
          "description": "Keys of items the LLM merged into this one (chosen only from server-suggested pairs).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemKey"
          }
        }
      },
      "required": [
        "why",
        "next",
        "judged_at",
        "inherited",
        "also_keys"
      ]
    },
    "ReviewLink": {
      "description": "The user's smart-review analysis of a pull request item.",
      "type": "object",
      "properties": {
        "analysis_id": {
          "description": "The newest analysis of the pull request.",
          "$ref": "#/$defs/AnalysisId"
        },
        "analysed_head": {
          "description": "Head commit it analysed.",
          "$ref": "#/$defs/CommitSha"
        },
        "head_moved": {
          "description": "The pull request head moved since.",
          "type": "boolean"
        },
        "has_my_state": {
          "description": "The user has saved review state on it.",
          "type": "boolean"
        }
      },
      "required": [
        "analysis_id",
        "analysed_head",
        "head_moved",
        "has_my_state"
      ]
    },
    "AnalysisId": {
      "description": "Identifier of an analysis (one per pull request, head commit and LLM language).",
      "type": "string",
      "format": "uuid"
    },
    "CommitSha": {
      "description": "A full 40-character hexadecimal git commit id.",
      "type": "string"
    }
  }
}
