{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemQuery",
  "description": "Query of `GET /api/v1/dashboard/items`; every filter is optional.",
  "type": "object",
  "properties": {
    "tier": {
      "description": "Only this tier.",
      "anyOf": [
        {
          "$ref": "#/$defs/Tier"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "description": "Only pull requests or only issues; absent = both. TODO items are listed whatever this filter says (while the\nuser shows MemCan TODOs, plan §G) unless `todos` is false.",
      "anyOf": [
        {
          "$ref": "#/$defs/GithubKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "todos": {
      "description": "`false` leaves TODO items out; absent = true. A TODOs-only list is not supported in v1.1.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "repo": {
      "description": "Only this repository, `owner/name`.",
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "description": "Only this score state.",
      "anyOf": [
        {
          "$ref": "#/$defs/ScoreState"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_since": {
      "description": "Only items changed at or after this time (TODOs: their change time).",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "limit": {
      "description": "Page size, [`ItemQuery::DEFAULT_LIMIT`] when absent, at most [`ItemQuery::MAX_LIMIT`].",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "cursor": {
      "description": "`next_cursor` of the previous page.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "Tier": {
      "description": "Priority tier.",
      "oneOf": [
        {
          "description": "Alarm, independent of the score.",
          "type": "string",
          "const": "p0"
        },
        {
          "description": "Score ≥ 65.",
          "type": "string",
          "const": "p1"
        },
        {
          "description": "Score 35–<65.",
          "type": "string",
          "const": "p2"
        },
        {
          "description": "Score < 35.",
          "type": "string",
          "const": "p3"
        }
      ]
    },
    "GithubKind": {
      "description": "GitHub item kinds of the list filter `kind`.",
      "oneOf": [
        {
          "description": "Pull requests.",
          "type": "string",
          "const": "pr"
        },
        {
          "description": "Issues.",
          "type": "string",
          "const": "issue"
        }
      ]
    },
    "ScoreState": {
      "description": "Whether a score is final.",
      "oneOf": [
        {
          "description": "Every part is final.",
          "type": "string",
          "const": "final"
        },
        {
          "description": "Some LLM part is carried over from before a change, or a computed default awaits confirmation (`~N`).",
          "type": "string",
          "const": "provisional"
        },
        {
          "description": "New item the LLM has not judged; computed parts plus named estimates (group \"Not judged yet\").",
          "type": "string",
          "const": "unjudged"
        }
      ]
    }
  }
}
